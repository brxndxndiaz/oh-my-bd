# ============================================================
# oh-my-bd config — sourced before plugins load.
# Edit with: omb config     Apply with: exec zsh
# ============================================================

# Plugins to skip (also managed by `omb disable <name>` / `omb enable <name>`):
OMBD_DISABLED_PLUGINS=()

# Load only these built-in plugins, in this order (default: all):
# OMBD_PLUGINS=(system git docker compose qol notes fzf autoenv)

# Autoenv: set to 0 to stop loading .env files on cd.
# OMBD_AUTOENV=1
# OMBD_AUTOENV_QUIET=0

# Docker: ask before mutating commands on a remote context (0 = never ask).
# OMBD_DOCKER_GUARD=1

# Notes file name (stored at the git root, or the current dir outside a repo).
# OMBD_NOTES_FILE=notes.md

# Ctrl+F "recent" scope: files changed within this many days.
# OMBD_RECENT_DAYS=3

# Use numbered menus instead of fzf pickers.
# OMBD_NO_FZF=1

# Skip the daily background update check.
# OMBD_SKIP_CHECK=1
