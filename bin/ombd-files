#!/usr/bin/env zsh
# ============================================================
# oh-my-bd — ombd-files — file lists for the Ctrl+F picker
#
#   ombd-files list <state-file>   print header + files for the current scope
#   ombd-files next <state-file>   switch to the next scope, then list
#   ombd-files preview <path>      preview a file from any scope
#   ombd-files text <root> <query>  find literal matches for the Text picker
#   ombd-files text-preview <quoted-path> <line>  preview around a match
#
# Scopes cycle with Tab: here → everywhere (~) → recent (~, newest first).
# Paths under $HOME are shown as ~/… in the global scopes.
# ============================================================

emulate -L zsh
setopt extendedglob

MODES=(here everywhere recent)
RECENT_DAYS="${OMBD_RECENT_DAYS:-3}"

# Big, noisy folders that are never what you're looking for.
SKIP=(.git node_modules .cache .npm .yarn .pnpm-store .cargo .rustup .gradle .m2
      .venv venv __pycache__ .Trash .local/share/Trash Library .docker .vscode-server
      go/pkg .terraform .next dist build target vendor)

mode_of() { local m; [[ -r "$1" ]] && m="$(<"$1")"; print -r -- "${m:-here}"; }

tilde() { sed "s|^$HOME/|~/|"; }

list_here() {
  if (( $+commands[fd] )); then
    fd --type f --hidden --follow --exclude .git
  else
    find . -type d -name .git -prune -o -type f -print 2>/dev/null | sed 's|^\./||'
  fi
}

list_everywhere() {
  if (( $+commands[fd] )); then
    fd --type f --hidden --follow --absolute-path ${(@)SKIP/#/--exclude=} . "$HOME" 2>/dev/null | tilde
  else
    local -a prune; local s
    for s in $SKIP; do prune+=(-name "${s:t}" -o); done
    find "$HOME" \( ${prune[1,-2]} \) -prune -o -type f -print 2>/dev/null | tilde
  fi
}

list_recent() {
  zmodload zsh/stat 2>/dev/null
  local -a files; local f m
  if (( $+commands[fd] )); then
    files=(${(f)"$(fd --type f --hidden --absolute-path --changed-within "${RECENT_DAYS}d" \
      ${(@)SKIP/#/--exclude=} . "$HOME" 2>/dev/null)"})
  else
    local -a prune; local s
    for s in $SKIP; do prune+=(-name "${s:t}" -o); done
    files=(${(f)"$(find "$HOME" \( ${prune[1,-2]} \) -prune -o -type f -mtime -"$RECENT_DAYS" -print 2>/dev/null)"})
  fi
  for f in $files; do
    zstat -A m +mtime -- "$f" 2>/dev/null && print -r -- "$m $f"
  done | sort -rn | head -500 | cut -d' ' -f2- | tilde
}

header() {
  local here="${PWD/#$HOME/~}"
  case "$1" in
    here)       print -r -- "▸ HERE  $here   ·   Tab → everywhere" ;;
    everywhere) print -r -- "▸ EVERYWHERE  ~   ·   Tab → recently modified" ;;
    recent)     print -r -- "▸ RECENTLY MODIFIED  last ${RECENT_DAYS} days   ·   Tab → here" ;;
  esac
}

list() {
  local mode; mode="$(mode_of "$1")"
  header "$mode"
  list_$mode
}

# Display text is separate from the quoted path and numeric line used for actions.
# One output row: quoted absolute path <TAB> line <TAB> display text.
text_row() {  # filename line content
  print -r -- "${(qqqq)${1:a}}"$'\t'"$2"$'\t'"${(V)1}:$2: ${(V)${3[1,500]}}"
}

list_text() {
  local root="$1" query="$2" filename match line content
  [[ -n "$query" ]] || return 0
  cd -- "$root" || return 1
  # fzf reloads run in a background process group. Allow zsh's pipeline setup
  # to proceed when its terminal-control call is denied.
  trap '' TTOU
  local engine="${OMBD_TEXT_ENGINE:-auto}"
  if [[ "$engine" == auto ]]; then
    if (( $+commands[rg] )); then engine=rg
    elif git rev-parse --is-inside-work-tree >/dev/null 2>&1; then engine=git
    else engine=grep; fi
  fi
  # Smart case like ripgrep: case-insensitive unless the query has a capital.
  local -a icase; [[ "$query" == *[[:upper:]]* ]] || icase=(-i)

  case "$engine" in
    rg)
      rg --no-config --color=never --null --with-filename --line-number --no-heading \
        --fixed-strings --smart-case --max-columns=500 --max-columns-preview -- "$query" . |
        while IFS= read -r -d '' filename && IFS= read -r match; do
          text_row "${filename#./}" "${match%%:*}" "${match#*:}"
        done ;;
    git)
      # Tracked + untracked files, honouring .gitignore; hidden files skipped like rg.
      git grep -z -n -I -F --untracked "${icase[@]}" -- "$query" ':!:**/.*' ':!:.*' |
        while IFS= read -r -d '' filename && IFS= read -r -d '' line && IFS= read -r content; do
          text_row "$filename" "$line" "$content"
        done ;;
    grep)
      # Name the top-level entries (no dotfiles) rather than ".", because
      # --exclude-dir='.*' would otherwise exclude the search root itself.
      local -a top; top=(*(N))
      (( ${#top} )) || return 0
      grep -rIn -H --null -F "${icase[@]}" --exclude='.*' --exclude-dir='.*' \
        --exclude-dir=node_modules -- "$query" "${top[@]}" |
        while IFS= read -r -d '' filename && IFS= read -r match; do
          text_row "${filename#./}" "${match%%:*}" "${match#*:}"
        done ;;
  esac
  local result=${pipestatus[1]}
  (( result <= 1 ))
}

preview_text() {
  local filename="${(Q)1}" line="$2"
  [[ "$line" == <-> && -f "$filename" ]] || return 1
  local start=$(( line > 12 ? line - 12 : 1 )) end=$(( line + 12 ))
  if (( $+commands[bat] )); then
    bat --color=always --style=numbers --line-range="$start:$end" --highlight-line="$line" -- "$filename"
  else
    awk -v start="$start" -v end="$end" -v match_line="$line" '
      NR >= start { printf "%s%6d  %s\n", (NR == match_line ? ">" : " "), NR, $0 }
      NR >= end { exit }
    ' < "$filename"
  fi
}

case "$1" in
  list) list "$2" ;;
  text) list_text "$2" "$3" ;;
  text-preview) preview_text "$2" "$3" ;;
  next)
    local cur i
    cur="$(mode_of "$2")"
    i=${MODES[(Ie)$cur]}
    print -r -- "${MODES[i % ${#MODES} + 1]}" > "$2"
    list "$2" ;;
  preview)
    local p="$2"
    [[ "$p" == "~/"* ]] && p="$HOME/${p#\~/}"
    if [[ -d "$p" ]]; then ls -la -- "$p"
    elif (( $+commands[bat] )); then bat --color=always --style=numbers --line-range=:200 -- "$p"
    elif (( $+commands[file] )) && [[ "$(file -b --mime -- "$p")" == *charset=binary* ]]; then
      print -r -- "(binary file)"; ls -la -- "$p"
    else head -200 -- "$p"; fi ;;
  *) print -u2 "usage: ombd-files list|next <state-file> | preview <path> | text <root> <query> | text-preview <quoted-path> <line>"; exit 1 ;;
esac
