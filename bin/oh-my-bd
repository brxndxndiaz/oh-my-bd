#!/usr/bin/env zsh
# ============================================================
# oh-my-bd — CLI (`omb` / `oh-my-bd`)
# ============================================================

emulate -L zsh
setopt extendedglob

export OMBD_DIR="${OMBD_DIR:-$HOME/.oh-my-bd}"
export OMBD_CONFIG_DIR="${OMBD_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-bd}"
export OMBD_CUSTOM="${OMBD_CUSTOM:-$OMBD_CONFIG_DIR/plugins}"
CONFIG_FILE="$OMBD_CONFIG_DIR/config.zsh"
REGISTRY="$OMBD_DIR/lib/commands.tsv"
ZSHRC="${ZDOTDIR:-$HOME}/.zshrc"
MARK_BEGIN='# >>> oh-my-bd >>>'
MARK_END='# <<< oh-my-bd <<<'

source "$OMBD_DIR/lib/utils.zsh" || { print -u2 "oh-my-bd not found at $OMBD_DIR"; exit 1; }
R=$OMBD_C_RED G=$OMBD_C_GREEN Y=$OMBD_C_YELLOW B=$OMBD_C_BLUE C=$OMBD_C_CYAN
BO=$OMBD_C_BOLD D=$OMBD_C_DIM X=$OMBD_C_RESET

VERSION="$(<"$OMBD_DIR/VERSION" 2>/dev/null)"
die() { print -u2 -- "${R}error:${X} $*"; exit 1; }

banner() {
  print -r -- "${B}"'       ______     __  __        __    __     __  __        ______     ___'
  print -r -- '      /\  __ \   /\ \_\ \      /\ "-./  \   /\ \_\ \      /\  == \   /\  __-.'
  print -r -- '      \ \ \/\ \  \ \  __ \     \ \ \-./\ \  \ \____ \     \ \  __<   \ \ \/\ \'
  print -r -- '       \ \_____\  \ \_\ \_\     \ \_\ \ \_\  \/\_____\     \ \_____\  \ \____-'
  print -r -- '        \/_____/   \/_/\/_/      \/_/  \/_/   \/_____/      \/_____/   \/____/'"${X}"
  print
}

# --- registry helpers ----------------------------------------
registry() { grep -v '^#' "$REGISTRY"; }
plugin_desc() {
  case "$1" in
    git) print "Git shortcuts and pickers" ;;      docker) print "Docker contexts, guard, container pickers" ;;
    compose) print "Docker Compose shortcuts" ;;   qol) print "Bookmarks, ports, archives, small tools" ;;
    notes) print "Project notes for you and AI agents" ;; autoenv) print "Load trusted .env files on cd" ;;
    system) print "ls, processes, clipboard, network" ;; fzf) print "Fuzzy keybindings and pickers" ;;
    omb) print "oh-my-bd itself" ;; *) print "custom plugin" ;;
  esac
}
print_rows() {   # stdin: plugin\tcommand\tdesc
  local p cmd desc
  while IFS=$'\t' read -r p cmd desc; do
    printf "  %s%-34s%s %s\n" "$G" "$cmd" "$X" "$desc"
  done
}

# --- config helpers ------------------------------------------
config_init() {
  [[ -f "$CONFIG_FILE" ]] && return
  mkdir -p "$OMBD_CONFIG_DIR"
  cp "$OMBD_DIR/config.example.zsh" "$CONFIG_FILE"
}
disabled_plugins() {
  [[ -r "$CONFIG_FILE" ]] || return 0
  ( source "$CONFIG_FILE" >/dev/null 2>&1; print -rl -- "${OMBD_DISABLED_PLUGINS[@]}" )
}
set_disabled() {   # args: new list
  config_init
  local tmp="$CONFIG_FILE.tmp.$$"
  grep -v '^OMBD_DISABLED_PLUGINS=' "$CONFIG_FILE" > "$tmp"
  print -r -- "OMBD_DISABLED_PLUGINS=(${(j: :)${(q)@}})" >> "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
}

# --- .zshrc block helpers ------------------------------------
# Remove our block (marker style, or the legacy v1 block) from .zshrc.
zshrc_strip() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local -a in out; in=("${(@f)$(<"$file")}")
  local i=1 n=${#in} skip=0 line
  local legacy='# oh-my-bd — git shortcuts, docker helpers, notes, CDC & more'
  while (( i <= n )); do
    line="${in[i]}"
    if [[ "$line" == "$MARK_BEGIN" ]]; then skip=1; (( i++ )); continue; fi
    if (( skip )); then [[ "$line" == "$MARK_END" ]] && skip=0; (( i++ )); continue; fi
    # legacy: "# ====" / header / "# ====" / export / source / alias omb
    if [[ "$line" == '# '=## && "${in[i+1]}" == "$legacy" ]]; then
      (( i += 2 ))
      [[ "${in[i]}" == '# '=## ]] && (( i++ ))
      while (( i <= n )) && [[ "${in[i]}" == (export\ OMBD_DIR=*|*lib/core.zsh*|alias\ omb=*) ]]; do (( i++ )); done
      [[ ${#out} -gt 0 && -z "${out[-1]}" ]] && out[-1]=()
      continue
    fi
    if [[ "$line" == "$legacy" ]]; then (( i++ )); continue; fi
    out+=("$line"); (( i++ ))
  done
  print -rl -- "${out[@]}" > "$file.omb.tmp" && mv -f "$file.omb.tmp" "$file"
}
zshrc_block() {
  cat <<EOF
$MARK_BEGIN
export OMBD_DIR="\$HOME/.oh-my-bd"
[[ ":\$PATH:" == *":\$HOME/.local/bin:"* ]] || export PATH="\$HOME/.local/bin:\$PATH"
[[ -f "\$OMBD_DIR/lib/core.zsh" ]] && source "\$OMBD_DIR/lib/core.zsh"
$MARK_END
EOF
}
zshrc_has_legacy() { grep -qF 'alias omb="oh-my-bd"' "$ZSHRC" 2>/dev/null; }
zshrc_has_block()  { grep -qxF "$MARK_BEGIN" "$ZSHRC" 2>/dev/null; }

# Upgrade a v1 .zshrc block to the marker block (keeps a backup).
zshrc_migrate() {
  zshrc_has_legacy || return 0
  cp "$ZSHRC" "$ZSHRC.omb-backup"
  zshrc_strip "$ZSHRC"
  { print; zshrc_block } >> "$ZSHRC"
  print "  ${G}✓${X} Migrated your .zshrc block (backup: ${ZSHRC/#$HOME/~}.omb-backup)"
}

# ============================================================
# Commands
# ============================================================

cmd_help() {
  banner
  print "${BO}USAGE${X}"
  print "  ${C}omb${X}                     command palette (fuzzy search every command)"
  print "  ${C}omb${X} <command> [args]"
  print
  print "${BO}COMMANDS${X}"
  print "  ${G}list${X} [plugin]           plugins, or one plugin's commands"
  print "  ${G}search${X} <term>           search commands"
  print "  ${G}cheatsheet${X}              everything on one page"
  print "  ${G}doctor${X}                  check your setup"
  print "  ${G}update${X}                  update oh-my-bd"
  print "  ${G}config${X}                  edit ${CONFIG_FILE/#$HOME/~}"
  print "  ${G}enable${X}|${G}disable${X} <plugin>  turn plugins on/off"
  print "  ${G}add${X}|${G}edit${X}|${G}remove${X} <name>  manage custom plugins"
  print "  ${G}changelog${X}               recent changes"
  print "  ${G}uninstall${X}               remove oh-my-bd"
  print "  ${G}version${X}                 show version"
  print
  print "${D}Every command also has its own help: cdc help, note help, branch help, repo help, …${X}"
}

cmd_list() {
  local -a disabled; disabled=(${(f)"$(disabled_plugins)"})
  if [[ -n "$1" ]]; then
    local rows; rows="$(registry | awk -F'\t' -v p="$1" '$1 == p')"
    if [[ -z "$rows" ]]; then
      if [[ -f "$OMBD_CUSTOM/$1.zsh" ]]; then
        print "${BO}${C}$1${X} ${D}(custom: ${OMBD_CUSTOM/#$HOME/~}/$1.zsh)${X}"
        grep -E '^(function )?[A-Za-z_][A-Za-z0-9_-]*( ?\(\))? ?\{|^alias ' "$OMBD_CUSTOM/$1.zsh" | sed 's/^/  /'
        return
      fi
      print "${R}Unknown plugin:${X} $1"; print "Run ${C}omb list${X} to see all plugins."; return 1
    fi
    print; print "${BO}${C}${(U)1}${X}  ${D}$(plugin_desc "$1")${X}"; print
    print -r -- "$rows" | print_rows; print
    return
  fi
  banner
  print "${BO}PLUGINS${X}"
  local p state
  for p in ${(u)${(f)"$(registry | cut -f1)"}}; do
    [[ "$p" == omb ]] && continue
    state=""; (( ${disabled[(Ie)$p]} )) && state=" ${Y}(disabled)${X}"
    printf "  %s%-9s%s %s%s\n" "$C" "$p" "$X" "$(plugin_desc "$p")" "$state"
    printf "            %s%s%s\n" "$D" "${(j:  :)${(@)${(f)"$(registry | awk -F'\t' -v p="$p" '$1 == p { print $2 }' | awk '{print $1}' | awk '!s[$0]++' | head -12)"}}}" "$X"
  done
  local -a custom; custom=($OMBD_CUSTOM/*.zsh(N:t:r))
  if (( ${#custom} )); then
    print; print "${BO}CUSTOM${X} ${D}(${OMBD_CUSTOM/#$HOME/~})${X}"
    for p in "${custom[@]}"; do printf "  %s%s%s\n" "$C" "$p" "$X"; done
  fi
  print; print "Run ${C}omb list <plugin>${X} for details, or just ${C}omb${X} to search."
}

cmd_search() {
  [[ -z "$1" ]] && die "Usage: omb search <term>"
  local hits; hits="$(registry | grep -i -- "$*")"
  [[ -z "$hits" ]] && { print "${Y}No matches for '$*'${X}"; return 1; }
  print -r -- "$hits" | print_rows
}

cmd_cheatsheet() {
  local p
  for p in ${(u)${(f)"$(registry | cut -f1)"}}; do
    print "${BO}${C}${(U)p}${X}"
    registry | awk -F'\t' -v p="$p" '$1 == p' | print_rows
    print
  done
}

cmd_version() { print "oh-my-bd ${VERSION:-unknown}"; }

cmd_changelog() {
  [[ -f "$OMBD_DIR/CHANGELOG.md" ]] || die "No CHANGELOG.md"
  if [[ -t 1 ]]; then
    awk '/^## /{n++} n<=2' "$OMBD_DIR/CHANGELOG.md" | ${=PAGER:-less -R}
  else
    awk '/^## /{n++} n<=2' "$OMBD_DIR/CHANGELOG.md"
  fi
}

cmd_update() {
  [[ -d "$OMBD_DIR/.git" ]] || die "Not a git checkout: $OMBD_DIR (reinstall with the installer)"
  cd "$OMBD_DIR" || exit 1
  local branch before target
  branch="$(git symbolic-ref --quiet --short HEAD)" || die "Detached HEAD in $OMBD_DIR. Switch to the install branch before updating."
  before="$(git rev-parse --verify HEAD)" || die "Cannot read the installed commit."
  print "Updating oh-my-bd…"
  git fetch --quiet origin "refs/heads/$branch" || die "Fetch failed for origin/$branch. Check your connection and branch."
  target="$(git rev-parse --verify FETCH_HEAD)" || die "Cannot read the fetched commit."
  if [[ "$before" != "$target" ]]; then
    git merge-base --is-ancestor "$before" "$target" ||
      die "Local commits prevent a fast-forward. Review the checkout at $OMBD_DIR."
    if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
      git status --short --untracked-files=no
      die "Local changes in $OMBD_DIR. Commit or stash them before updating."
    fi
    git merge --ff-only --no-overwrite-ignore --quiet "$target" ||
      die "Could not fast-forward. Check the checkout at $OMBD_DIR."
  fi
  mkdir -p "$OMBD_CONFIG_DIR" && print -r -- "$EPOCHSECONDS 0" > "$OMBD_CONFIG_DIR/update-check" 2>/dev/null
  zshrc_migrate
  if [[ "$before" == "$(git rev-parse HEAD)" ]]; then
    print "${G}Already up to date${X} ($(<VERSION))."
  else
    print "${G}Updated to $(<VERSION).${X} Changes:"
    git log --oneline --no-decorate "$before"..HEAD | head -20 | sed 's/^/  /'
    if [[ "${OMBD_UPDATE_IN_SHELL:-0}" != 1 ]]; then
      print "\nOpen a new terminal to load the update."
    fi
  fi
}

cmd_config() {
  config_init
  ${=EDITOR:-vi} "$CONFIG_FILE"
  zsh -n "$CONFIG_FILE" && print "Saved. Run ${C}exec zsh${X} to apply."
}

cmd_enable() {
  [[ -z "$1" ]] && die "Usage: omb enable <plugin>"
  local -a d; d=(${(f)"$(disabled_plugins)"})
  (( ${d[(Ie)$1]} )) || { print "$1 is already enabled."; return; }
  set_disabled "${(@)d:#$1}"
  print "${G}Enabled${X} $1. Run ${C}exec zsh${X} to apply."
}

cmd_disable() {
  [[ -z "$1" ]] && die "Usage: omb disable <plugin>"
  [[ -f "$OMBD_DIR/plugins/$1.zsh" || -f "$OMBD_CUSTOM/$1.zsh" ]] || die "Unknown plugin: $1"
  local -a d; d=(${(f)"$(disabled_plugins)"})
  (( ${d[(Ie)$1]} )) && { print "$1 is already disabled."; return; }
  set_disabled "${d[@]}" "$1"
  print "${Y}Disabled${X} $1. Run ${C}exec zsh${X} to apply."
}

cmd_add() {
  local name="$1"
  [[ "$name" == [A-Za-z0-9_-]## ]] || die "Usage: omb add <name>  (letters, digits, - and _)"
  local file="$OMBD_CUSTOM/$name.zsh"
  [[ -f "$file" ]] && die "Plugin already exists: $file"
  mkdir -p "$OMBD_CUSTOM"
  cat > "$file" <<EOF
# ============================================================
# $name — custom oh-my-bd plugin (created $(date +%F))
# Loaded automatically. Helpers available: ombd_has, ombd_confirm,
# ombd_pick, ombd_open, ombd_color — see \$OMBD_DIR/lib/utils.zsh
# ============================================================

# function hello {
#   print "hello from $name"
# }
EOF
  print "${G}Created${X} ${file/#$HOME/~}"
  [[ -t 1 ]] && ombd_confirm "Open it now?" y && ${=EDITOR:-vi} "$file"
  print "Run ${C}exec zsh${X} to load it."
}

cmd_edit() {
  local file="$OMBD_CUSTOM/$1.zsh"
  [[ -f "$file" ]] || die "No custom plugin '$1' (omb add $1 to create)"
  ${=EDITOR:-vi} "$file"
}

cmd_remove() {
  local file="$OMBD_CUSTOM/$1.zsh"
  [[ -n "$1" && -f "$file" ]] || die "No custom plugin '$1'. Built-in plugins can be turned off with: omb disable <name>"
  ombd_confirm "Delete ${file/#$HOME/~}?" || return 1
  rm -f -- "$file" && print "Removed $1."
}

cmd_install() {
  [[ -r "$OMBD_DIR/install.sh" ]] || die "install.sh not found"
  sh "$OMBD_DIR/install.sh" "$@"
}

cmd_uninstall() {
  print "${Y}This removes oh-my-bd from your shell and deletes $OMBD_DIR.${X}"
  ombd_confirm "Continue?" || { print "Cancelled."; return; }

  if [[ -f "$ZSHRC" ]] && { zshrc_has_block || zshrc_has_legacy; }; then
    cp "$ZSHRC" "$ZSHRC.omb-backup"
    zshrc_strip "$ZSHRC"
    print "  ${G}✓${X} Removed from ${ZSHRC/#$HOME/~} (backup: .zshrc.omb-backup)"
  fi
  local fish="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"
  if [[ -f "$fish" ]] && grep -q 'oh-my-bd' "$fish"; then
    grep -v -e 'oh-my-bd.fish' -e '^# oh-my-bd Fish integration$' "$fish" > "$fish.omb.tmp" && mv -f "$fish.omb.tmp" "$fish"
    print "  ${G}✓${X} Removed from fish config"
  fi
  local l
  for l in "$HOME/.local/bin/oh-my-bd" "$HOME/.local/bin/omb"; do
    [[ -L "$l" ]] && rm -f "$l" && print "  ${G}✓${X} Removed ${l/#$HOME/~}"
  done
  if [[ -d "$OMBD_CONFIG_DIR" || -f "$HOME/.cdc_dirs" ]]; then
    if ombd_confirm "Also delete your config, custom plugins and bookmarks?"; then
      rm -rf -- "$OMBD_CONFIG_DIR" "$HOME/.cdc_dirs" && print "  ${G}✓${X} Removed config and bookmarks"
    else
      print "  ${D}Kept ${OMBD_CONFIG_DIR/#$HOME/~} and ~/.cdc_dirs${X}"
    fi
  fi
  rm -f "$HOME/.ombd_last_check"
  [[ -d "$OMBD_DIR" ]] && rm -rf -- "$OMBD_DIR" && print "  ${G}✓${X} Removed ${OMBD_DIR/#$HOME/~}"
  print "\n${G}Uninstalled.${X} Open a new terminal."
}

cmd_doctor() {
  local fails=0 warns=0
  ok()   { print "  ${G}✓${X} $*"; }
  warn() { print "  ${Y}!${X} $*"; (( warns++ )); }
  fail() { print "  ${R}✗${X} $*"; (( fails++ )); }

  banner
  print "${BO}oh-my-bd ${VERSION}${X}  ${D}${OMBD_DIR/#$HOME/~}${X}\n"

  print "${BO}Required${X}"
  ombd_has zsh && ok "zsh $ZSH_VERSION" || fail "zsh not found"
  ombd_has git && ok "git $(git --version | awk '{print $3}')" || fail "git not found"

  print "\n${BO}Optional${X}"
  if ombd_has fzf; then
    local v="${$(fzf --version)%% *}"
    if [[ "${v%%.*}" -gt 0 || "${${v#*.}%%.*}" -ge 48 ]]; then ok "fzf $v"
    else warn "fzf $v is old — keybindings come from your distro's files; 0.48+ recommended"; fi
  else warn "fzf not installed — pickers fall back to numbered menus"; fi
  local t
  for t in fd rg bat docker lazydocker tree thefuck lsof; do
    ombd_has $t && ok "$t" || print "  ${D}- $t (optional)${X}"
  done

  print "\n${BO}Installation${X}"
  [[ -f "$OMBD_DIR/lib/core.zsh" ]] && ok "core found" || fail "core.zsh missing in $OMBD_DIR"
  if zshrc_has_block; then ok ".zshrc configured"
  elif zshrc_has_legacy; then warn ".zshrc uses the old v1 block — run ${C}omb update${X} to migrate (it shadows the palette)"
  else fail "oh-my-bd is not sourced from ${ZSHRC/#$HOME/~} — run the installer"; fi
  [[ ":$PATH:" == *":$HOME/.local/bin:"* ]] && ok "~/.local/bin is on PATH" || warn "~/.local/bin is not on PATH (omb CLI symlinks live there)"
  if [[ -f "$CONFIG_FILE" ]]; then
    zsh -n "$CONFIG_FILE" 2>/dev/null && ok "config ${CONFIG_FILE/#$HOME/~}" || fail "syntax error in ${CONFIG_FILE/#$HOME/~}"
  else print "  ${D}- no config file (omb config to create)${X}"; fi
  local f
  for f in "$OMBD_DIR"/plugins/*.zsh "$OMBD_CUSTOM"/*.zsh(N); do
    zsh -n "$f" 2>/dev/null || fail "syntax error in ${f/#$HOME/~}"
  done

  print "\n${BO}Load test${X}"
  local out
  out="$(OMBD_SKIP_CHECK=1 OMBD_SILENT=0 zsh -ic 'source "$OMBD_DIR/lib/core.zsh"' 2>&1 >/dev/null </dev/null |
    grep -v -e '^\[oh-my-bd\] .env' -e 'Untrusted .env' -e 'sets:' -e 'Load it' )"
  [[ -z "$out" ]] && ok "loads cleanly" || { fail "errors while loading:"; print -r -- "$out" | sed 's/^/      /' | head -10; }

  local -a d; d=(${(f)"$(disabled_plugins)"})
  (( ${#d} )) && print "\n${D}Disabled plugins: ${d[*]}${X}"

  print
  if (( fails )); then print "${R}$fails problem(s), $warns warning(s)${X}"; return 1
  elif (( warns )); then print "${Y}$warns warning(s)${X}"
  else print "${G}All good.${X}"; fi
}

# ============================================================
case "${1:-help}" in
  help|-h|--help|palette|p) cmd_help ;;
  list|ls)       shift; cmd_list "$@" ;;
  search|s)      shift; cmd_search "$@" ;;
  cheatsheet|cs) cmd_cheatsheet ;;
  doctor)        cmd_doctor ;;
  update|upgrade) cmd_update ;;
  config)        cmd_config ;;
  enable)        shift; cmd_enable "$@" ;;
  disable)       shift; cmd_disable "$@" ;;
  add|new)       shift; cmd_add "$@" ;;
  edit)          shift; cmd_edit "$@" ;;
  remove|rm)     shift; cmd_remove "$@" ;;
  install)       shift; cmd_install "$@" ;;
  uninstall)     cmd_uninstall ;;
  changelog)     cmd_changelog ;;
  migrate-zshrc) zshrc_migrate ;;   # internal, used by install.sh
  version|-v|--version) cmd_version ;;
  *) print -u2 "${R}Unknown command:${X} $1"; print -u2 "Run ${C}omb help${X}."; exit 1 ;;
esac
